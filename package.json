{
  "name": "react-tomtom-maps",
  "version": "2.9.0",
  "description": "React wrapper for MapLibre GL with some TomTom API defaults",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "npm-watch compile",
    "compile": "tsc --skipLibCheck",
    "build": "npm run compile",
    "prepare": "npm run build"
  },
  "files": [
    "lib",
    "dist",
    "src"
  ],
  "devDependencies": {
    "@types/lodash": "4.14.186",
    "@types/react": "^17.0.2",
    "npm-watch": "^0.6.0",
    "tslint": "^5.17.0",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^4.0.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "maplibre-gl": "^5.6.0",
    "react-fast-compare": "^2.0.4",
    "uuid": "^3.3.3"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "watch": {
    "compile": {
      "silent": false,
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx"
    }
  }
}